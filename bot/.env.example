# These are normally supplied by the Java plugin (see config.yml -> bot:) when it launches the bot.
# They are listed here for running the bot standalone during development:
#   cd bot && bun install && bun run src/index.ts

# Discord bot token
BOT_TOKEN=

# Shared secret used as the WebSocket RPC handshake token (must match config.yml -> api.token)
API_TOKEN=change-me-please
# Loopback port the bot's WebSocket RPC server listens on (the Java server connects to it)
RPC_PORT=8789
# Legacy loopback HTTP bridge address (kept for reference)
API_URL=http://127.0.0.1:8787

# TypeORM connection to the same networked database the Java server writes to.
# When the bot is enabled the plugin runs on MySQL/Postgres only (embedded SQLite is not supported).
DB_TYPE=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sexidium
DB_USER=sexidium
DB_PASSWORD=sexidium

# Optional: register slash commands instantly to a single guild
GUILD_ID=
# Optional: Discord role id allowed to use staff commands (falls back to Administrator permission)
ADMIN_ROLE_ID=

# Optional: channels for real-time event relays (unset = that relay is disabled)
LOG_CHANNEL_ID=
EVENTS_CHANNEL_ID=
