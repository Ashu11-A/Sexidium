{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "#env": ["./src/env.ts"],
      "#base": ["./src/discord/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
