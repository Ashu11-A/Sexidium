# Copy to ./.env (repo root, gitignored) and fill in, then: docker compose up --build
# The bot token stays out of version control — it is read from here / the host environment only.
SEXIDIUM_BOT_TOKEN=
# Optional: register slash commands instantly to one guild
SEXIDIUM_BOT_GUILD_ID=
# Optional: override the shared WS/command secret (defaults to sexidium-debug-secret)
SEXIDIUM_API_TOKEN=sexidium-debug-secret
