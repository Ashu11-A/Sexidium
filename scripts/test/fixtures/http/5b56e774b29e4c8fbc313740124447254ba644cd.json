rldgen thread even if the level was set.\n"}],"downloads":{"server:default":{"name":"paper-26.1.2-17.jar","checksums":{"sha256":"34dfceac6a5b8cce2a5ef1495b5f77340d175c03910cbc85fcb90db20cb3a22d"},"size":52902987,"url":"https://fill-data.papermc.io/v1/objects/34dfceac6a5b8cce2a5ef1495b5f77340d175c03910cbc85fcb90db20cb3a22d/paper-26.1.2-17.jar"}}},{"id":16,"time":"2026-04-20T09:18:16Z","channel":"ALPHA","commits":[{"sha":"4be1a310c2a9e81a14a235304bb120a1bd05bd4f","time":"2026-04-20T09:15:28Z","message":"Add EntityScheduler#scheduleOrExecute\n\nThis is useful on Folia where we may want to try to avoid\nscheduling a delayed task.\n"}],"downloads":{"server:default":{"name":"paper-26.1.2-16.jar","checksums":{"sha256":"c38ff0ebb68a0f568eb3d591dd1d2eb3524e484455745e9657a926ddb4c00473"},"size":52902669,"url":"https://fill-data.papermc.io/v1/objects/c38ff0ebb68a0f568eb3d591dd1d2eb3524e484455745e9657a926ddb4c00473/paper-26.1.2-16.jar"}}},{"id":15,"time":"2026-04-19T16:43:01Z","channel":"ALPHA","commits":[{"sha":"66d3bbed3878387649d4b9f72e78780e33b2d85d","time":"2026-04-19T16:41:44Z","message":"Update frosted ice patch for 26.1\n"},{"sha":"d0be5e20fdc57e4830895960188bd365065b9a13","time":"2026-04-19T14:14:54Z","message":"Call BlockFadeEvent for FrostedIce (#13764)"},{"sha":"dd0810c4affb6a3c2b1ec6c1cf0f19a43c87d48e","time":"2026-04-19T14:14:21Z","message":"Skip inactive AI ticks for unaware mobs (#13781)"}],"downloads":{"server:default":{"name":"paper-26.1.2-15.jar","checksums":{"sha256":"f439b6d6bfc8c62346419ca677bd5aba0db801836418ca9dcc4fb6ad593516f1"},"size":52901930,"url":"https://fill-data.papermc.io/v1/objects/f439b6d6bfc8c62346419ca677bd5aba0db801836418ca9dcc4fb6ad593516f1/paper-26.1.2-15.jar"}}},{"id":13,"time":"2026-04-19T14:09:55Z","channel":"ALPHA","commits":[{"sha":"04ee8eac9b1bc40884f59e296d3cb113c669dd9c","time":"2026-04-19T14:08:48Z","message":"Remove Paper config unsupported-settings.compression-format (#13800)"},{"sha":"c58cba39fbfb54df32388b03ab5123f158664904",